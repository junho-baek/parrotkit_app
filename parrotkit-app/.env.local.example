# ---------------------------------------------------------------------------
# ParrotKit Expo / React Native env
# ---------------------------------------------------------------------------
# This file belongs to the mobile app in parrotkit-app/.
# Expo exposes EXPO_PUBLIC_* values to the client bundle.
# Never put Super Data, Supadata, Replicate, Supabase secret, database, or
# payment webhook secrets in this file.

# Mobile app -> ParrotKit API server.
# Issue #19 reference analysis uses the Go service /v1/reference-analysis route.
# For same-LAN device QA, use your Mac LAN IP, e.g. http://192.168.0.10:8787.
EXPO_PUBLIC_PARROTKIT_API_URL="http://localhost:8787"

# Dev-only escape hatch. Keep blank/false outside local UI testing.
# When true, failed reference analysis creates the old local mock board.
EXPO_PUBLIC_REFERENCE_ANALYSIS_DEV_FALLBACK=""

# Optional once mobile auth reads Supabase directly.
# These are public Supabase browser/mobile values, not service credentials.
EXPO_PUBLIC_SUPABASE_URL="https://your-parrotkit-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-parrotkit-publishable-key"

# Optional future native subscription SDK public keys.
# Leave blank until native billing is implemented.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=""
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=""
