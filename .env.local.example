# ---------------------------------------------------------------------------
# ParrotKit server env
# ---------------------------------------------------------------------------
# This file belongs to the root Next.js app.
# The root app is the API/server runtime deployed to Vercel.
# Do not copy server secrets into parrotkit-app/.env.local because Expo public
# env vars are bundled into the mobile client.

# Public app URL used by redirects and mobile clients.
NEXT_PUBLIC_APP_URL="https://parrotkit-deploy.vercel.app"

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------

# Optional: keep ref here for safety checks/scripts.
SUPABASE_PROJECT_REF="your-parrotkit-project-ref"

# Browser/mobile-safe auth values.
NEXT_PUBLIC_SUPABASE_URL="https://your-parrotkit-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-parrotkit-publishable-key"

# Server-only Supabase credential for admin flows, migrations, and backfills.
SUPABASE_SECRET_KEY="your-parrotkit-secret-key"

# Server-side DB tools and Next.js/serverless workloads should use the pooled URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require"

# Optional: only keep this while migrating old users from a previous DB.
LEGACY_DATABASE_URL="postgresql://user:password@legacy-host/legacydb?sslmode=require"

# ---------------------------------------------------------------------------
# Reference analysis providers
# ---------------------------------------------------------------------------
# Current v1 uses Super Data/Supadata for reference URL data and Replicate for
# model execution. Gemini/OpenAI/Anthropic direct keys are not required when
# those models are used through Replicate.

# Preferred app-level name.
SUPERDATA_API_KEY="your-super-data-api-key"
# Optional legacy/vendor-name alias. Leave blank unless older code or tooling expects it.
SUPADATA_API_KEY=""

REPLICATE_API_TOKEN="r8_your-replicate-api-token"

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# The app only knows the GTM container ID. GA4 Measurement ID and Meta Pixel ID
# stay inside GTM.
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# ---------------------------------------------------------------------------
# Web checkout, current implementation
# ---------------------------------------------------------------------------
# Native iOS/Android subscriptions should be implemented through store billing
# or a native subscription broker later. The current web server still contains
# Lemon Squeezy checkout/webhook routes.
LEMONSQUEEZY_API_KEY="your-lemonsqueezy-api-key"
LEMONSQUEEZY_STORE_ID="your-store-id"
LEMONSQUEEZY_PRODUCT_ID="your-product-id"
LEMONSQUEEZY_WEBHOOK_SECRET="your-webhook-secret"
NEXT_PUBLIC_VARIANT_PRO="your-variant-id"

# ---------------------------------------------------------------------------
# Notion Report Automation (optional)
# ---------------------------------------------------------------------------
# Used only by scripts/setup-notion-reports.cjs and
# scripts/upload-report-to-notion.cjs. Do not run upload automation unless
# explicitly requested.
NOTION_API_KEY="secret_your_notion_internal_integration_token"
NOTION_REPORTS_PARENT_PAGE_ID="your-notion-parent-page-id"
NOTION_REPORTS_DATABASE_ID="your-notion-database-id"
NOTION_REPORTS_DATA_SOURCE_ID="your-notion-data-source-id"
NOTION_REPORTS_DATABASE_TITLE="Parrotkit Reports"
NOTION_API_VERSION="2025-09-03"
